# Copie para .env e preencha:   cp .env.example .env
# O .env fica fora do git (.gitignore). Nunca versione o preenchido.

# Senha do painel. Vazio DESATIVA a autenticação — só faça isso localmente.
UI_PASSWORD=

# Segredo que assina o cookie de sessão. Gere com:  openssl rand -hex 32
# Sem ele, o painel sorteia um a cada boot e todo restart desloga todo mundo.
UI_SESSION_SECRET=

# Opcional — endereços do servidor mostrados na Visão geral (para DNS).
# Sem SERVER_PUBLIC_IP, o painel descobre o IP público consultando
# api.ipify.org; PUBLIC_IP_LOOKUP=0 desliga essa consulta.
# Dentro do Docker, o painel só enxerga o IP do container: informe aqui o
# IP da máquina na rede interna (separe vários por vírgula).
# SERVER_PUBLIC_IP=
# SERVER_INTERNAL_IP=
# PUBLIC_IP_LOOKUP=1
